<Window x:Class="RUAIUnlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RU AI Unlocker" Height="700" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#293548"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="PurpleHoverBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="RedBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8,8,0,0" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#293548"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="BorderBrush" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7C3AED"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RU AI Unlocker" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Border Background="#2E1065" CornerRadius="12" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6"/>
                    </Border>
                    <Border Background="#1E1B4B" CornerRadius="12" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Управление и обновление hosts для разблокировки AI-сервисов" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Сбросить DNS" Click="BtnFlushDns_Click" Margin="0,0,8,0"/>
                <Button Content="Открыть hosts" Click="BtnOpenHostsFile_Click"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Главная">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Orientation="Vertical">
                        <Border x:Name="AppUpdateBannerBorder" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Доступна новая версия программы!" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <Border Background="#4338CA" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtNewAppVersion" Text="v1.0.1" FontSize="11" FontWeight="Bold" Foreground="#E0E7FF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtAppChangelog" Text="..." FontSize="13" Foreground="#C7D2FE" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="60"/>
                                    <ProgressBar x:Name="PrgAppUpdate" Height="4" Margin="0,8,0,0" Visibility="Collapsed" Background="#312E81" Foreground="#818CF8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button x:Name="BtnApplyAppUpdate" Content="Обновить программу" Style="{StaticResource AccentButtonStyle}" Click="BtnApplyAppUpdate_Click" Margin="0,0,8,0"/>
                                    <Button Content="GitHub" Click="BtnOpenAppRelease_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="UpdateBannerBorder" Background="#2E1065" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Доступно обновление hosts!" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock x:Name="UpdateBannerText" Text="Новая версия от ..." FontSize="13" Foreground="#C4B5FD" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Обновить сейчас" Style="{StaticResource AccentButtonStyle}" Click="BtnUpdateHosts_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Версия hosts" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtLastUpdate" Text="Загрузка..." FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Источник: dns.malw.link" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Активных записей" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtEntriesCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,6,0,0"/>
                                    <TextBlock Text="Разблокированных доменов" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Размер файла hosts" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="TxtFileSize" Text="0 KB" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,0"/>
                                    <TextBlock Text="C:\Windows\System32\..." FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Быстрые действия" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>
                                <WrapPanel Margin="-4">
                                    <Button x:Name="BtnCheckUpdate" Content="Проверить обновления hosts" Style="{StaticResource AccentButtonStyle}" Click="BtnCheckUpdate_Click" Margin="4" Padding="18,10"/>
                                    <Button x:Name="BtnCheckAppUpdate" Content="Проверить обновление программы" Click="BtnCheckAppUpdate_Click" Margin="4" Padding="18,10"/>
                                    <Button x:Name="BtnUpdateHosts" Content="Обновить hosts из репозитория" Style="{StaticResource AccentButtonStyle}" Click="BtnUpdateHosts_Click" Margin="4" Padding="18,10"/>
                                    <Button Content="Создать бэкап" Click="BtnCreateBackup_Click" Margin="4" Padding="18,10"/>
                                    <Button Content="Сбросить кэш DNS" Click="BtnFlushDns_Click" Margin="4" Padding="18,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="О модуле" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                                <TextBlock Text="RU AI Unlocker разблокирует доступ к популярным AI сервисам (ChatGPT, Claude, Gemini и др.) через безопасный редирект хостов без замедления трафика." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="18"/>
                                <TextBlock x:Name="TxtAppInfo" Text="RU AI Unlocker v1.0.0  |  Репозиторий: github.com/f1ndles/RU_AI-UNLOCKER  |  Источник хостов: dns.malw.link" FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Записи Hosts">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtSearch" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" 
                                 Padding="10,8" FontSize="13" TextChanged="TxtSearch_TextChanged"/>
                        
                        <Button Grid.Column="1" Content="Очистить поиск" Click="BtnClearSearch_Click" Margin="8,0,0,0"/>
                    </Grid>

                    <DataGrid x:Name="DgHosts" Grid.Row="1" Background="#1E293B" RowBackground="#1E293B" 
                              AlternatingRowBackground="#243044" Foreground="#F8FAFC" 
                              BorderBrush="#334155" BorderThickness="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP-адрес" Binding="{Binding Ip}" Width="140"/>
                            <DataGridTextColumn Header="Домен" Binding="{Binding Domain}" Width="*"/>
                            <DataGridTextColumn Header="Секция / Категория" Binding="{Binding Section}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtFilterCount" Text="Всего записей: 0" VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Добавить запись" Click="BtnAddEntry_Click" Margin="0,0,8,0"/>
                            <Button Content="Удалить выбранную" Click="BtnDeleteEntry_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Бэкапы">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DgBackups" Grid.Row="0" Background="#1E293B" RowBackground="#1E293B" 
                              AlternatingRowBackground="#243044" Foreground="#F8FAFC" 
                              BorderBrush="#334155" BorderThickness="1"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Файл бэкапа" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Дата создания" Binding="{Binding Date}" Width="180"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeFormatted}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Создать бэкап" Click="BtnCreateBackup_Click" Margin="0,0,8,0"/>
                        <Button Content="Открыть папку бэкапов" Click="BtnOpenBackupDir_Click" Margin="0,0,8,0"/>
                        <Button Content="Откатить на выбранный" Style="{StaticResource AccentButtonStyle}" Click="BtnRestoreBackup_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Журнал">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="LbLogs" Grid.Row="0" Background="#1E293B" Foreground="#94A3B8" 
                             BorderBrush="#334155" BorderThickness="1"
                             FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Копировать всё" Click="BtnCopyLogs_Click" Margin="0,0,8,0"/>
                        <Button Content="Очистить журнал" Click="BtnClearLogs_Click" Margin="0,0,8,0"/>
                        <Button Content="Открыть файл логов" Click="BtnOpenLogFile_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus" Text="Готово" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
            <ProgressBar x:Name="PbStatus" Grid.Column="1" Width="120" Height="6" IsIndeterminate="False" Visibility="Collapsed" Foreground="#8B5CF6"/>
        </Grid>
    </Grid>
</Window>
